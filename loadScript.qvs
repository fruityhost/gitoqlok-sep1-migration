///$tab 00 Main
/*=====================================================================================
  APPLICATION : Rental Analytics - Enterprise Reference Model
  PURPOSE     : Production-shaped Qlik Sense application used as a migration baseline.
  SOURCE      : PostgreSQL "pagila" (Aiven) - schemas public + mig
  ARCHITECTURE: Direct extract from Postgres -> transform in memory -> star schema

  PORTABILITY TO SUPERSET
    Everything this app displays comes from a table or view in Postgres. There is no
    generated data, no QVD layer, no sampling filter and no scaling expression in this
    script. Point Superset at the same objects and it returns identical rows with no
    additional configuration.

      mig.v_synthetic_sales   129,043 rows   the volume extension, pre-sampled
      mig.v_budget              2,336 rows   plan, pre-scaled to match the sample
      mig.fx_rates              7,671 rows   EUR / GBP / KZT daily
      public.payment           16,049 rows   real ERP transactions, never sampled
      public.film, actor, film_actor, film_category, category, language,
             address, city, country, customer, staff, store, inventory, rental

    The subset is defined ONCE, in the database, by mig.v_sample_config. To change
    density, edit subset-views.sql and re-run it. Nothing here or in Superset changes.

  RELOAD PERFORMANCE - roughly 42 seconds
    The connection matters more than the row count. The original used
    UseDeclareFetch=1;Fetch=200 - 200 rows per network round trip, ~2,580 trips for
    516k rows, measured at 300s. PostgreSQL_pagila_bulk uses
    UseDeclareFetch=0;Fetch=20000 and did the same 516k rows in 78s. Read-only.

  DETERMINISM
    Rand() appears nowhere. mig.synthetic_sales was built from md5 hashes of stable
    seeds, so reloads are byte-identical. The only derived values in this script are
    two documented modulo expressions on DimFilm and DimCustomer, each of which keeps
    its raw source value alongside.

  DO NOT load ad-hoc spreadsheets into this app. A Sheet1$ table carrying Country and
  Date columns was added on 28/08 and closed a circular reference, forcing Qlik to mark
  FactSales as a LOOSE table. Selections then stop propagating. Removed 28/08.
=====================================================================================*/

SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='hh:mm:ss';
SET DateFormat='DD/MM/YYYY';
SET TimestampFormat='DD/MM/YYYY hh:mm:ss[.fff]';
SET FirstWeekDay=0;
SET BrokenWeeks=0;
SET ReferenceDay=4;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:µ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';

SET ErrorMode=1;
SET HidePrefix='%';

///$tab 01 Config

SET vDbConnection = 'PostgreSQL_pagila_bulk';

// Window covered by the volume extension. Must match mig._params in Postgres.
LET  vGenStartDate = Num(MakeDate(2021,1,1));
LET  vGenEndDate   = Num(MakeDate(2026,8,31));
LET  vGenDays      = $(vGenEndDate) - $(vGenStartDate) + 1;

SET vReportingCurrency   = 'USD';
SET vTargetMarginPct     = 0.42;
SET vLateReturnGraceDays = 1;

SET vSetCY   = {<[Year]={$(=Max([Year]))}, [Date]=>};
SET vSetLY   = {<[Year]={$(=Max([Year])-1)}, [Date]=>};
SET vSetYTD  = {<[Year]={$(=Max([Year]))}, [Is YTD]={1}, [Date]=>};
SET vSetLYTD = {<[Year]={$(=Max([Year])-1)}, [Is YTD]={1}, [Date]=>};

SET vColorPrimary   = '#1a6fb4';
SET vColorSecondary = '#f2a341';
SET vColorPositive  = '#2e8b57';
SET vColorNegative  = '#c0392b';
SET vColorNeutral   = '#8d9aa5';

LET vReloadStartNum = Num(Now(1));
LET vReloadStartTxt = Timestamp(Now(1));
TRACE >>> Reload started at $(vReloadStartTxt);

///$tab 02 Extract - Source tables
/*-------------------------------------------------------------------------------------
  Each source object is read from Postgres exactly once into a temporary _src table.
  Mapping tables and dimensions are built RESIDENT off these, so nothing is queried
  twice over the wire. The _src tables are dropped as soon as they are consumed.

  Every statement here is a plain SELECT with no WHERE clause. That is deliberate: the
  SQL is meant to be transplantable to Superset verbatim.
-------------------------------------------------------------------------------------*/

LIB CONNECT TO [$(vDbConnection)];

[_srcFilm]:
LOAD *;
SELECT film_id, title, description, release_year, language_id,
       rental_duration, rental_rate::float8 AS rental_rate, length,
       replacement_cost::float8 AS replacement_cost, rating::text AS rating,
       array_to_string(special_features, ', ') AS special_features
FROM film;

[_srcActor]:
LOAD *;
SELECT actor_id, first_name, last_name FROM actor;

[_srcFilmActor]:
LOAD *;
SELECT film_id, actor_id FROM film_actor;

[_srcFilmCategory]:
LOAD *;
SELECT film_id, category_id FROM film_category;

[_srcCategory]:
LOAD *;
SELECT category_id, name AS category_name FROM category;

[_srcLanguage]:
LOAD *;
SELECT language_id, trim(name) AS language_name FROM language;

[_srcGeography]:
LOAD *;
SELECT a.address_id, a.address, a.district, a.postal_code, a.phone,
       c.city_id, c.city, co.country_id, co.country
FROM address a
JOIN city c     ON c.city_id     = a.city_id
JOIN country co ON co.country_id = c.country_id;

[_srcCustomer]:
LOAD *;
SELECT customer_id, store_id, first_name, last_name, email, address_id,
       activebool::int AS activebool,
       to_char(create_date,'YYYY-MM-DD') AS create_date_txt
FROM customer;

[_srcStaff]:
LOAD *;
SELECT staff_id, first_name, last_name, email, store_id, address_id,
       active::int AS active, username
FROM staff;

[_srcStore]:
LOAD *;
SELECT store_id, manager_staff_id, address_id FROM store;

[_srcInventory]:
LOAD *;
SELECT inventory_id, film_id, store_id FROM inventory;

[_srcRental]:
LOAD
    rental_id,
    inventory_id,
    Round(Timestamp#(return_date_txt,'YYYY-MM-DD hh:mm:ss')
        - Timestamp#(rental_date_txt,'YYYY-MM-DD hh:mm:ss')) AS rental_days;
SELECT rental_id, inventory_id,
       to_char(rental_date,'YYYY-MM-DD HH24:MI:SS') AS rental_date_txt,
       to_char(return_date,'YYYY-MM-DD HH24:MI:SS') AS return_date_txt
FROM rental;

/* Real ERP transactions, taken in full. The incremental high-water-mark pattern is not
   possible without a QVD to persist the watermark and the prior history.            */
[_srcPayment]:
LOAD
    payment_id, customer_id, staff_id, rental_id, amount,
    Timestamp#(payment_date_txt,'YYYY-MM-DD hh:mm:ss') AS PaymentTimestamp;
SELECT payment_id, customer_id, staff_id, rental_id, amount::float8 AS amount,
       to_char(payment_date,'YYYY-MM-DD HH24:MI:SS') AS payment_date_txt
FROM payment;

LET vErpRows = NoOfRows('_srcPayment');
TRACE >>> ERP payment rows: $(vErpRows);

/* The volume extension. The view already contains the subset - no filter here. */
[_srcVolume]:
LOAD
    Num(Date#(gen_date_txt,'YYYY-MM-DD')) AS GenDateNum,
    synthetic_id, film_id, store_id, customer_id, staff_id,
    rental_days, list_price, discount_amount, net_amount, unit_cost,
    payment_method, channel, is_late;
SELECT to_char(gen_date,'YYYY-MM-DD') AS gen_date_txt,
       synthetic_id, film_id, store_id, customer_id, staff_id,
       rental_days,
       list_price::float8      AS list_price,
       discount_amount::float8 AS discount_amount,
       net_amount::float8      AS net_amount,
       unit_cost::float8       AS unit_cost,
       payment_method, channel, is_late
FROM mig.v_synthetic_sales;

LET vVolRows = NoOfRows('_srcVolume');
TRACE >>> Volume extension rows: $(vVolRows);

/* Plan figures. The view is already scaled to match the sampled fact - no scaling here. */
[_srcBudget]:
LOAD budget_month_txt, store_id, category_id,
     budget_amount, budget_units, target_margin_pct;
SELECT to_char(budget_month,'YYYY-MM') AS budget_month_txt,
       store_id, category_id,
       budget_amount::float8     AS budget_amount,
       budget_units::float8      AS budget_units,
       target_margin_pct::float8 AS target_margin_pct
FROM mig.v_budget;

[FXRates]:
LOAD
    Num(Date#(rate_date_txt,'YYYY-MM-DD')) AS [%DateKey],
    currency                               AS [Currency],
    rate_to_usd                            AS [Rate to USD];
SELECT to_char(rate_date,'YYYY-MM-DD') AS rate_date_txt,
       currency, rate_to_usd::float8 AS rate_to_usd
FROM mig.fx_rates;

DISCONNECT;

///$tab 03 Mapping Tables

[MapCategory]:
MAPPING LOAD category_id, category_name RESIDENT [_srcCategory];

[MapLanguage]:
MAPPING LOAD language_id, language_name RESIDENT [_srcLanguage];

[MapFilmCategoryId]:
MAPPING LOAD film_id, category_id RESIDENT [_srcFilmCategory];

[MapAddressCity]:
MAPPING LOAD address_id, city RESIDENT [_srcGeography];

[MapAddressCountry]:
MAPPING LOAD address_id, country RESIDENT [_srcGeography];

[MapAddressDistrict]:
MAPPING LOAD address_id, district RESIDENT [_srcGeography];

[MapAddressLine]:
MAPPING LOAD address_id, address RESIDENT [_srcGeography];

[MapInventoryFilm]:
MAPPING LOAD inventory_id, film_id RESIDENT [_srcInventory];

[MapInventoryStore]:
MAPPING LOAD inventory_id, store_id RESIDENT [_srcInventory];

[MapRentalInventory]:
MAPPING LOAD rental_id, inventory_id RESIDENT [_srcRental];

[MapRentalDays]:
MAPPING LOAD rental_id, rental_days RESIDENT [_srcRental];

/* Hand-maintained business hierarchies - reference data that lives in the script,
   exactly the sort of thing a migration has to account for.                        */
[MapCategoryGroup]:
MAPPING LOAD * INLINE [
category_name, category_group
Action, Mainstream
Adventure, Mainstream
Animation, Family
Children, Family
Classics, Catalogue
Comedy, Mainstream
Documentary, Catalogue
Drama, Mainstream
Family, Family
Foreign, Catalogue
Games, Family
Horror, Genre
Music, Genre
New, Mainstream
Sci-Fi, Genre
Sports, Genre
];

[MapRatingDesc]:
MAPPING LOAD * INLINE [
rating, rating_description
G, General Audiences
PG, Parental Guidance Suggested
PG-13, Parents Strongly Cautioned
R, Restricted
NC-17, Adults Only
];

[MapRegion]:
MAPPING LOAD * INLINE [
country, region
United States, North America
Canada, North America
Mexico, North America
Brazil, Latin America
Argentina, Latin America
Chile, Latin America
Colombia, Latin America
Venezuela, Latin America
Peru, Latin America
Ecuador, Latin America
Dominican Republic, Latin America
Puerto Rico, Latin America
United Kingdom, Europe
Germany, Europe
France, Europe
Italy, Europe
Spain, Europe
Poland, Europe
Netherlands, Europe
Sweden, Europe
Switzerland, Europe
Austria, Europe
Ukraine, Europe
Russian Federation, Europe
Belarus, Europe
Bulgaria, Europe
Czech Republic, Europe
Hungary, Europe
Romania, Europe
Slovakia, Europe
Greece, Europe
Latvia, Europe
Estonia, Europe
Moldova, Europe
Turkey, EMEA
Israel, EMEA
Saudi Arabia, EMEA
United Arab Emirates, EMEA
Egypt, EMEA
Nigeria, EMEA
South Africa, EMEA
Kenya, EMEA
Morocco, EMEA
Algeria, EMEA
Tunisia, EMEA
Sudan, EMEA
Tanzania, EMEA
Zambia, EMEA
Cameroon, EMEA
Angola, EMEA
China, Asia Pacific
India, Asia Pacific
Japan, Asia Pacific
Indonesia, Asia Pacific
Philippines, Asia Pacific
Vietnam, Asia Pacific
Thailand, Asia Pacific
South Korea, Asia Pacific
Taiwan, Asia Pacific
Australia, Asia Pacific
New Zealand, Asia Pacific
Pakistan, Asia Pacific
Bangladesh, Asia Pacific
Nepal, Asia Pacific
Sri Lanka, Asia Pacific
Malaysia, Asia Pacific
Myanmar, Asia Pacific
Cambodia, Asia Pacific
Kazakstan, Asia Pacific
Azerbaijan, Asia Pacific
Iran, Asia Pacific
Iraq, EMEA
Yemen, EMEA
Oman, EMEA
Kuwait, EMEA
];

///$tab 04 Transform - Dimensions

[DimFilm]:
LOAD
    film_id                                                      AS [%FilmKey],
    film_id                                                      AS [Film ID],
    title                                                        AS [Film Title],
    description                                                  AS [Film Description],
    /* DETERMINISTIC DERIVATION - pagila stamps release_year = 2006 on all 1,000 titles,
       leaving no usable time dimension on the catalogue. Superset equivalent:
           2006 - MOD(film_id * 7, 27)                                                */
    2006 - Mod(film_id * 7, 27)                                  AS [Release Year],
    release_year                                                 AS [Source Release Year],
    ApplyMap('MapLanguage', language_id, 'Unknown')               AS [Language],
    rental_duration                                              AS [Standard Rental Days],
    rental_rate                                                  AS [List Rental Rate],
    replacement_cost                                             AS [Replacement Cost],
    length                                                       AS [Runtime Minutes],
    rating                                                       AS [Rating],
    ApplyMap('MapRatingDesc', rating, 'Not Rated')                AS [Rating Description],
    special_features                                             AS [Special Features],
    ApplyMap('MapCategory', ApplyMap('MapFilmCategoryId', film_id, 0), 'Uncategorised') AS [Category],
    ApplyMap('MapCategoryGroup',
        ApplyMap('MapCategory', ApplyMap('MapFilmCategoryId', film_id, 0), 'Uncategorised'),
        'Other')                                                 AS [Category Group],
    If(length < 60,  '1. Under 60 min',
      If(length < 90,  '2. 60-90 min',
        If(length < 120, '3. 90-120 min',
          If(length < 150, '4. 120-150 min', '5. 150+ min'))))     AS [Runtime Band],
    If(rental_rate <= 0.99, 'Value',
      If(rental_rate <= 2.99, 'Standard', 'Premium'))             AS [Price Tier],
    Dual(Floor((2006 - Mod(film_id * 7, 27))/10)*10 & 's',
         Floor((2006 - Mod(film_id * 7, 27))/10)*10)              AS [Release Decade]
RESIDENT [_srcFilm];

[DimActor]:
LOAD
    actor_id                                                     AS [%ActorKey],
    actor_id                                                     AS [Actor ID],
    Capitalize(first_name) & ' ' & Capitalize(last_name)          AS [Actor Name],
    Capitalize(last_name)                                         AS [Actor Surname]
RESIDENT [_srcActor];

// True many-to-many bridge: a film has many actors, an actor appears in many films.
[BridgeFilmActor]:
LOAD
    film_id                                                      AS [%FilmKey],
    actor_id                                                     AS [%ActorKey]
RESIDENT [_srcFilmActor];

[DimCustomer]:
LOAD
    customer_id                                                  AS [%CustomerKey],
    customer_id                                                  AS [Customer ID],
    Capitalize(first_name) & ' ' & Capitalize(last_name)          AS [Customer Name],
    Capitalize(last_name)                                         AS [Customer Surname],
    Lower(email)                                                  AS [Customer Email],
    /* DETERMINISTIC DERIVATION - pagila stamps create_date = 2020-02-14 on every
       customer. Superset equivalent:
           create_date - (MOD(customer_id * 13, 1500) * INTERVAL '1 day')             */
    Date(Date#(create_date_txt,'YYYY-MM-DD') - Mod(customer_id * 13, 1500)) AS [Customer Since],
    Year(Date#(create_date_txt,'YYYY-MM-DD') - Mod(customer_id * 13, 1500)) AS [Customer Cohort Year],
    Date(Date#(create_date_txt,'YYYY-MM-DD'))                     AS [Source Create Date],
    store_id                                                      AS [Home Store ID],
    ApplyMap('MapAddressLine',     address_id, 'Unknown')         AS [Customer Address],
    ApplyMap('MapAddressCity',     address_id, 'Unknown')         AS [City],
    ApplyMap('MapAddressDistrict', address_id, 'Unknown')         AS [District],
    ApplyMap('MapAddressCountry',  address_id, 'Unknown')         AS [Country],
    ApplyMap('MapRegion', ApplyMap('MapAddressCountry', address_id, 'Unknown'), 'Rest of World') AS [Region]
RESIDENT [_srcCustomer];

[DimStore]:
LOAD
    store_id                                                     AS [%StoreKey],
    store_id                                                     AS [Store ID],
    'Store ' & store_id & ' - ' & ApplyMap('MapAddressCity', address_id, 'Unknown') AS [Store Name],
    ApplyMap('MapAddressCity',    address_id, 'Unknown')          AS [Store City],
    ApplyMap('MapAddressCountry', address_id, 'Unknown')          AS [Store Country],
    ApplyMap('MapRegion', ApplyMap('MapAddressCountry', address_id, 'Unknown'), 'Rest of World') AS [Store Region],
    manager_staff_id                                              AS [Store Manager ID]
RESIDENT [_srcStore];

///$tab 05 SCD Type 2 - Staff
/*-------------------------------------------------------------------------------------
  Type 2 slowly changing dimension. The source holds only the current row, so version
  boundaries are fixed offsets from the window start - deterministic, no Rand().
  IntervalMatch resolves the effective version per (date, staff); the result collapses
  into a mapping table so no synthetic keys survive into the published model.
-------------------------------------------------------------------------------------*/

[DimStaff]:
LOAD
    AutoNumber(staff_id & '|' & VersionNo, 'StaffVersion')        AS [%StaffVersionKey],
    staff_id                                                      AS [Staff ID],
    staff_name                                                    AS [Staff Name],
    email                                                         AS [Staff Email],
    VersionNo                                                     AS [Staff Version],
    StaffRole                                                     AS [Staff Role],
    AssignedStore                                                 AS [Staff Store ID],
    Date(ValidFrom)                                               AS [Version Valid From],
    Date(ValidTo)                                                 AS [Version Valid To],
    If(ValidTo >= $(vGenEndDate), 'Current', 'Historic')           AS [Version Status]
;
LOAD
    staff_id,
    Capitalize(first_name) & ' ' & Capitalize(last_name)                           AS staff_name,
    email,
    IterNo()                                                                       AS VersionNo,
    Pick(IterNo(), 'Sales Assistant', 'Senior Assistant', 'Store Supervisor')       AS StaffRole,
    If(IterNo() = 1, 3 - store_id, store_id)                                        AS AssignedStore,
    If(IterNo() = 1, $(vGenStartDate) - 500,
       If(IterNo() = 2, $(vGenStartDate) + 430, $(vGenStartDate) + 1180))           AS ValidFrom,
    If(IterNo() = 1, $(vGenStartDate) + 429,
       If(IterNo() = 2, $(vGenStartDate) + 1179, $(vGenEndDate) + 3650))            AS ValidTo
RESIDENT [_srcStaff]
WHILE IterNo() <= 3;

[_StaffSpan]:
LOAD
    [%StaffVersionKey],
    [Staff ID]                                            AS StaffIdIv,
    Num([Version Valid From])                             AS VF,
    Num([Version Valid To])                               AS VT
RESIDENT [DimStaff];

[_StaffDates]:
LOAD
    $(vGenStartDate) - 600 + RecNo() - 1 AS EffDate
AUTOGENERATE $(vGenDays) + 700;

JOIN ([_StaffDates])
LOAD DISTINCT StaffIdIv RESIDENT [_StaffSpan];

[_StaffResolved]:
INTERVALMATCH (EffDate, StaffIdIv)
LOAD VF, VT, StaffIdIv RESIDENT [_StaffSpan];

LEFT JOIN ([_StaffResolved])
LOAD VF, VT, StaffIdIv, [%StaffVersionKey] RESIDENT [_StaffSpan];

[MapStaffVersion]:
MAPPING LOAD
    EffDate & '|' & StaffIdIv AS _k,
    [%StaffVersionKey]        AS _v
RESIDENT [_StaffResolved];

DROP TABLES [_StaffSpan], [_StaffDates], [_StaffResolved];

// Source tables no longer needed - everything downstream is RESIDENT or mapped.
DROP TABLES [_srcFilm], [_srcActor], [_srcFilmActor], [_srcFilmCategory],
            [_srcCategory], [_srcLanguage], [_srcGeography], [_srcCustomer],
            [_srcStaff], [_srcStore], [_srcInventory];

///$tab 06 Transform - Fact
/*-------------------------------------------------------------------------------------
  Single-grain fact (one row = one rental transaction), concatenating two sources with
  an identical field signature:
     1. real ERP rows        - public.payment -> rental -> inventory
     2. the volume extension - mig.v_synthetic_sales
  [Source System] keeps the two streams separable for reconciliation.
-------------------------------------------------------------------------------------*/

[FactSales]:
LOAD
    AutoNumber(TxnId, 'Txn')                                        AS [%TransactionKey],
    [%FilmKey],
    [%CustomerKey],
    [%StoreKey],
    ApplyMap('MapStaffVersion', DateID & '|' & StaffID, Null())     AS [%StaffVersionKey],
    DateID                                                          AS [%DateKey],
    AutoNumber(Date(MonthStart(DateID),'YYYY-MM') & '|' & [%StoreKey] & '|' & CategoryId, 'Budget') AS [%BudgetKey],
    [Source System],
    [Payment Method],
    [Channel],
    [Rental Days],
    [Is Late Return],
    Rentals,
    [Gross Amount],
    [Discount Amount],
    [Net Amount],
    [Cost Amount],
    [Net Amount] - [Cost Amount]                                    AS [Margin Amount]
;
LOAD
    'ERP-' & payment_id                                             AS TxnId,
    ApplyMap('MapInventoryFilm', ApplyMap('MapRentalInventory', rental_id, 0), 1)  AS [%FilmKey],
    customer_id                                                     AS [%CustomerKey],
    ApplyMap('MapInventoryStore', ApplyMap('MapRentalInventory', rental_id, 0), 1) AS [%StoreKey],
    ApplyMap('MapFilmCategoryId',
        ApplyMap('MapInventoryFilm', ApplyMap('MapRentalInventory', rental_id, 0), 1), 0) AS CategoryId,
    staff_id                                                        AS StaffID,
    Num(Floor(PaymentTimestamp))                                    AS DateID,
    'ERP (PostgreSQL)'                                              AS [Source System],
    'Card'                                                          AS [Payment Method],
    'In-Store'                                                      AS [Channel],
    Alt(Num(ApplyMap('MapRentalDays', rental_id, Null())), 5)        AS [Rental Days],
    0                                                               AS [Is Late Return],
    1                                                               AS Rentals,
    amount                                                          AS [Gross Amount],
    0                                                               AS [Discount Amount],
    amount                                                          AS [Net Amount],
    Round(amount * 0.55, 0.01)                                      AS [Cost Amount]
RESIDENT [_srcPayment];

DROP TABLES [_srcPayment], [_srcRental];

CONCATENATE ([FactSales])
LOAD
    AutoNumber(TxnId, 'Txn')                                        AS [%TransactionKey],
    [%FilmKey],
    [%CustomerKey],
    [%StoreKey],
    ApplyMap('MapStaffVersion', DateID & '|' & StaffID, Null())     AS [%StaffVersionKey],
    DateID                                                          AS [%DateKey],
    AutoNumber(Date(MonthStart(DateID),'YYYY-MM') & '|' & [%StoreKey] & '|' & CategoryId, 'Budget') AS [%BudgetKey],
    [Source System],
    [Payment Method],
    [Channel],
    [Rental Days],
    [Is Late Return],
    Rentals,
    [Gross Amount],
    [Discount Amount],
    [Net Amount],
    [Cost Amount],
    [Net Amount] - [Cost Amount]                                    AS [Margin Amount]
;
LOAD
    'PG-' & synthetic_id                                            AS TxnId,
    film_id                                                         AS [%FilmKey],
    customer_id                                                     AS [%CustomerKey],
    store_id                                                        AS [%StoreKey],
    ApplyMap('MapFilmCategoryId', film_id, 0)                       AS CategoryId,
    staff_id                                                        AS StaffID,
    GenDateNum                                                      AS DateID,
    'Volume Extension'                                              AS [Source System],
    payment_method                                                  AS [Payment Method],
    channel                                                         AS [Channel],
    rental_days                                                     AS [Rental Days],
    is_late                                                         AS [Is Late Return],
    1                                                               AS Rentals,
    list_price                                                      AS [Gross Amount],
    discount_amount                                                 AS [Discount Amount],
    net_amount                                                      AS [Net Amount],
    unit_cost                                                       AS [Cost Amount]
RESIDENT [_srcVolume];

DROP TABLE [_srcVolume];

LET vFactRows = NoOfRows('FactSales');
TRACE >>> Total fact rows: $(vFactRows);

///$tab 07 Budget
/*-------------------------------------------------------------------------------------
  Budget sits at a different grain to the fact (month x store x category) and links by
  a composite key, built identically on both sides. mig.v_budget is already scaled to
  match the sampled fact, so nothing is adjusted here.
-------------------------------------------------------------------------------------*/

[FactBudget]:
LOAD
    AutoNumber(budget_month_txt & '|' & store_id & '|' & category_id, 'Budget') AS [%BudgetKey],
    budget_amount        AS [Budget Amount],
    budget_units         AS [Budget Units],
    target_margin_pct    AS [Target Margin %]
RESIDENT [_srcBudget];

DROP TABLE [_srcBudget];

///$tab 08 Master Calendar

[_CalRange]:
LOAD Min([%DateKey]) AS MinD, Max([%DateKey]) AS MaxD RESIDENT [FactSales];
LET vCalMin = Num(Peek('MinD',0,'_CalRange'));
LET vCalMax = Num(Peek('MaxD',0,'_CalRange'));
DROP TABLE [_CalRange];

LET vCalStart = Num(Floor(YearStart($(vCalMin))));
LET vCalEnd   = Num(Floor(YearEnd($(vCalMax))));
LET vCalDays  = $(vCalEnd) - $(vCalStart) + 1;
LET vMaxYear  = Year($(vCalMax));
LET vMaxMonth = Num(Month($(vCalMax)));

[MasterCalendar]:
LOAD
    [%DateKey],
    Date([%DateKey])                                                                AS [Date],
    Year([%DateKey])                                                                AS [Year],
    Dual('Q' & Ceil(Num(Month([%DateKey]))/3), Ceil(Num(Month([%DateKey]))/3))        AS [Quarter],
    Year([%DateKey]) & '-Q' & Ceil(Num(Month([%DateKey]))/3)                         AS [Year Quarter],
    Month([%DateKey])                                                               AS [Month],
    Dual(Date(MonthStart([%DateKey]),'MMM YYYY'), MonthStart([%DateKey]))            AS [Month Year],
    Week([%DateKey])                                                                AS [Week],
    Year([%DateKey]) & '-W' & Num(Week([%DateKey]), '00')                            AS [Year Week],
    Day([%DateKey])                                                                 AS [Day of Month],
    WeekDay([%DateKey])                                                             AS [Weekday],
    If(Num(WeekDay([%DateKey])) >= 5, 'Weekend', 'Weekday')                          AS [Day Type],
    If(Num(Month([%DateKey])) >= 4, Year([%DateKey]), Year([%DateKey])-1)             AS [Fiscal Year],
    'FQ' & (Floor(Mod(Num(Month([%DateKey])) - 4 + 12, 12)/3) + 1)                    AS [Fiscal Quarter],
    If(Year([%DateKey]) = $(vMaxYear), 1, 0)                                         AS [Is Current Year],
    If(Year([%DateKey]) = $(vMaxYear)-1, 1, 0)                                       AS [Is Prior Year],
    If(Num(Month([%DateKey])) <= $(vMaxMonth), 1, 0)                                 AS [Is YTD],
    If([%DateKey] > AddMonths($(vCalMax), -12) and [%DateKey] <= $(vCalMax), 1, 0)    AS [Is Last 12 Months],
    If(MonthStart([%DateKey]) = MonthStart($(vCalMax)), 1, 0)                         AS [Is Current Month],
    ($(vMaxYear)*12 + $(vMaxMonth)) - (Year([%DateKey])*12 + Num(Month([%DateKey])))  AS [Months Ago]
;
LOAD
    $(vCalStart) + RecNo() - 1 AS [%DateKey]
AUTOGENERATE $(vCalDays);

///$tab 09 Customer Segmentation
/*-------------------------------------------------------------------------------------
  RFM value banding. Cut-offs come from the ACTUAL spend distribution, so the tiers
  cannot collapse if the density changes. Superset equivalent: PERCENTILE_CONT over
  the same aggregate.
-------------------------------------------------------------------------------------*/

[_CustomerSpend]:
LOAD
    [%CustomerKey],
    Sum([Net Amount])   AS LifetimeSpend,
    Sum(Rentals)        AS LifetimeRentals,
    Max([%DateKey])     AS LastRentalDate
RESIDENT [FactSales]
GROUP BY [%CustomerKey];

[_Fractiles]:
LOAD
    Fractile(LifetimeSpend, 0.50) AS P50,
    Fractile(LifetimeSpend, 0.80) AS P80,
    Fractile(LifetimeSpend, 0.95) AS P95
RESIDENT [_CustomerSpend];

LET vBandP50 = Num(Peek('P50',0,'_Fractiles'));
LET vBandP80 = Num(Peek('P80',0,'_Fractiles'));
LET vBandP95 = Num(Peek('P95',0,'_Fractiles'));
DROP TABLE [_Fractiles];
TRACE >>> Value band cut-offs: P50=$(vBandP50) P80=$(vBandP80) P95=$(vBandP95);

LEFT JOIN ([DimCustomer])
LOAD
    [%CustomerKey],
    Round(LifetimeSpend, 0.01)                                     AS [Customer Lifetime Value],
    LifetimeRentals                                                AS [Customer Lifetime Rentals],
    Date(LastRentalDate)                                           AS [Customer Last Rental],
    Floor($(vCalMax) - LastRentalDate)                             AS [Customer Recency Days],
    If(LifetimeSpend > $(vBandP95), 'A - Champion',
      If(LifetimeSpend > $(vBandP80), 'B - Frequent',
        If(LifetimeSpend > $(vBandP50), 'C - Regular',
                                        'D - Occasional')))         AS [Value Segment],
    If(LifetimeSpend > $(vBandP95), 'Platinum',
      If(LifetimeSpend > $(vBandP80), 'Gold',
        If(LifetimeSpend > $(vBandP50), 'Silver',
                                        'Bronze')))                 AS [Loyalty Tier],
    If($(vCalMax) - LastRentalDate > 180, 'At Risk',
       If($(vCalMax) - LastRentalDate > 90, 'Cooling', 'Engaged'))  AS [Engagement Status]
RESIDENT [_CustomerSpend];

DROP TABLE [_CustomerSpend];

///$tab 10 Finalize

TAG FIELDS [%FilmKey], [%CustomerKey], [%StoreKey], [%ActorKey], [%DateKey],
           [%StaffVersionKey], [%BudgetKey], [%TransactionKey] WITH '$hidden';

COMMENT TABLE [FactSales]       WITH 'Transaction-grain fact. public.payment plus the volume extension from mig.v_synthetic_sales.';
COMMENT TABLE [FactBudget]      WITH 'Plan from mig.v_budget, month x store x category, linked via composite %BudgetKey.';
COMMENT TABLE [DimFilm]         WITH 'Film master including category, price tier and runtime banding.';
COMMENT TABLE [DimCustomer]     WITH 'Customer master enriched with RFM value segmentation.';
COMMENT TABLE [DimStaff]        WITH 'Type 2 slowly changing dimension - one row per staff version.';
COMMENT TABLE [DimStore]        WITH 'Store master with geography rollup.';
COMMENT TABLE [DimActor]        WITH 'Actor master, associated to films through BridgeFilmActor.';
COMMENT TABLE [BridgeFilmActor] WITH 'Many-to-many bridge between films and actors.';
COMMENT TABLE [MasterCalendar]  WITH 'Canonical date dimension with fiscal calendar and relative-period flags.';
COMMENT TABLE [FXRates]         WITH 'Daily FX rates from mig.fx_rates.';

COMMENT FIELD [Net Amount]               WITH 'Revenue net of discounts, inclusive of late fees. Base currency USD.';
COMMENT FIELD [Margin Amount]            WITH 'Net Amount less Cost Amount.';
COMMENT FIELD [Is YTD]                   WITH 'Flag = 1 when the date falls on or before the latest loaded month, in any year.';
COMMENT FIELD [Value Segment]            WITH 'RFM value band derived at load time from spend percentiles (P50 / P80 / P95).';
COMMENT FIELD [Source System]            WITH 'ERP (PostgreSQL) = public.payment. Volume Extension = mig.v_synthetic_sales.';
COMMENT FIELD [Customer Lifetime Value]  WITH 'Sum of Net Amount across all loaded periods.';
COMMENT FIELD [Staff Version]            WITH 'SCD2 version number. Use Version Status = Current for the live org structure.';
COMMENT FIELD [Release Year]             WITH 'Deterministic derivation: 2006 - MOD(film_id*7,27). Raw value in Source Release Year.';
COMMENT FIELD [Customer Since]           WITH 'Deterministic derivation: create_date - MOD(customer_id*13,1500) days. Raw value in Source Create Date.';

LET vReloadEndNum  = Num(Now(1));
LET vReloadEndTxt  = Timestamp(Now(1));
LET vReloadSeconds = Round(($(vReloadEndNum) - $(vReloadStartNum)) * 86400, 1);

[ReloadAudit]:
LOAD 'Reload finished'    AS [Audit Metric], '$(vReloadEndTxt)'   AS [Audit Value] AUTOGENERATE 1;
CONCATENATE ([ReloadAudit]) LOAD 'Duration (seconds)' AS [Audit Metric], '$(vReloadSeconds)' AS [Audit Value] AUTOGENERATE 1;
CONCATENATE ([ReloadAudit]) LOAD 'Fact rows'          AS [Audit Metric], '$(vFactRows)'      AS [Audit Value] AUTOGENERATE 1;
CONCATENATE ([ReloadAudit]) LOAD 'ERP rows'           AS [Audit Metric], '$(vErpRows)'       AS [Audit Value] AUTOGENERATE 1;
CONCATENATE ([ReloadAudit]) LOAD 'Volume rows'        AS [Audit Metric], '$(vVolRows)'       AS [Audit Value] AUTOGENERATE 1;
CONCATENATE ([ReloadAudit]) LOAD 'Calendar from'      AS [Audit Metric], Date($(vCalStart))  AS [Audit Value] AUTOGENERATE 1;
CONCATENATE ([ReloadAudit]) LOAD 'Calendar to'        AS [Audit Metric], Date($(vCalEnd))    AS [Audit Value] AUTOGENERATE 1;

TRACE >>> Reload complete in $(vReloadSeconds) seconds. Fact rows: $(vFactRows);

///$tab 11 Section Access (disabled)
/*-------------------------------------------------------------------------------------
  DELIBERATELY DISABLED. Enabling this locks out any account not listed below.

SECTION ACCESS;

[AccessTable]:
LOAD * INLINE [
ACCESS,  USERID,                     %REDUCTION_STORE,  OMIT
ADMIN,   DATANOMIX\qlikservice,      *,
USER,    DATANOMIX\store1.manager,   1,                 Customer Email
USER,    DATANOMIX\store2.manager,   2,                 Customer Email
];

SECTION APPLICATION;
-------------------------------------------------------------------------------------*/
